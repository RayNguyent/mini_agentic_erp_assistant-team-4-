# Provider mode: "deterministic" (default, requires nothing below), "openai",
# or "ollama". Deterministic must always work with every other value in this
# file left blank.
LLM_PROVIDER=deterministic

# Used when LLM_PROVIDER=openai. Also used as a fallback embedding key when
# EMBEDDINGS_ENABLED=true and LLM_PROVIDER is not ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override to point an OpenAI-compatible endpoint elsewhere. Ignored (defaults
# to http://localhost:11434/v1) when LLM_PROVIDER=ollama unless set explicitly.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_S=10

# Embeddings are a separate switch from generation: BM25-only retrieval is
# always available and is the offline guarantee. Set true to also build the
# Chroma vector index at ingest time (requires OPENAI_API_KEY or Ollama).
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small

# Demo bearer tokens -> {user_id, role}. JSON string; leave unset to use the
# built-in defaults (dev-token/pm-token/audit-token — see app/security/auth.py).
AUTH_TOKENS_JSON=

# Tool + provider behavior.
TOOL_TIMEOUT_S=10
ERP_PROVIDER=mock

# Paths (relative to the repo root).
INDEX_DIR=data/index
CORPUS_DIR=docs/corpus
